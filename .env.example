# Copy this file to .env and fill in your values. Never commit .env.

# Needed from M3 onward (Claude Console -> API keys)
ANTHROPIC_API_KEY=

# Model the agent uses. Check the Anthropic docs for current model names.
PM_AGENT_MODEL=

# Optional: Slack incoming webhook URL for `python -m pm_agent.brief --slack` (keep it secret)
SLACK_WEBHOOK_URL=

# Optional: point the tools at a different data directory (defaults to data/sample)
# PM_AGENT_DATA_DIR=
